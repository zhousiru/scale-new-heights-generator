{
  "name": "@syru/byted-sticker-generator",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "description": "中文勇攀高峰表情包与飞书头像生成器，支持浏览器 UI 与 Node 无头 PNG 渲染。",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhousiru/scale-new-heights-generator.git"
  },
  "homepage": "https://zhousiru.github.io/scale-new-heights-generator",
  "bugs": {
    "url": "https://github.com/zhousiru/scale-new-heights-generator/issues"
  },
  "main": "./lib/sticker/index.mjs",
  "module": "./lib/sticker/index.mjs",
  "types": "./lib/sticker/index.d.mts",
  "exports": {
    ".": "./lib/sticker/index.mjs",
    "./avatar": "./lib/sticker/avatar.mjs",
    "./avatar/core": "./lib/sticker/avatar/core.mjs",
    "./avatar/node": "./lib/sticker/avatar/node.mjs",
    "./core": "./lib/sticker/core.mjs",
    "./node": "./lib/sticker/node.mjs"
  },
  "files": [
    "lib",
    "public/DouyinSansBold.woff2",
    "public/YouSheBiaoTiHei.ttf",
    "CHANGELOG.md",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "pnpm run build:app && pnpm run build:package",
    "build:app": "vite build",
    "build:package": "tsdown",
    "lint": "oxlint .",
    "preview": "vite preview",
    "test": "vitest run",
    "benchmark": "pnpm run build:package && node scripts/benchmark-generation.mjs",
    "audit:size": "node scripts/audit-size.mjs",
    "calibrate:colors": "node scripts/calibrate-byte-style.mjs --check",
    "prepack": "pnpm run build:package"
  },
  "dependencies": {
    "culori": "^4.0.2",
    "hdrify": "^0.12.1",
    "inter-ui": "^4.1.1"
  },
  "optionalDependencies": {
    "@napi-rs/canvas": "^1.0.2"
  },
  "devDependencies": {
    "@iconify/react": "^6.0.2",
    "@radix-ui/react-collapsible": "^1.1.16",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-slider": "^1.4.3",
    "@radix-ui/react-slot": "^1.3.0",
    "@tanstack/react-router": "^1.170.18",
    "@types/culori": "^4.0.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "oxlint": "^1.74.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsdown": "^0.22.8",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.11.0"
}
